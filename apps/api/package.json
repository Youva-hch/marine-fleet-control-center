{
  "name": "@fleet-control/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests/time-series.test.ts tests/trajectory-geojson.test.ts"
  },
  "dependencies": {
    "@fleet-control/contracts": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13"
  }
}
